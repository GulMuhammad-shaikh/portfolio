# MongoDB Atlas Connection String (configure in Vercel Environment Variables)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Optional Automated Confirmation Emails
# Option A: Resend API Key (Recommended)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Option B: Gmail SMTP via App Password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
